# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_NAME="Yaye Academy"
DEFAULT_CURRENCY="ETB"
DEFAULT_TIMEZONE="Africa/Addis_Ababa"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Local PostgreSQL from compose.yaml
DATABASE_URL="postgresql://yaye_academy:yaye_academy@localhost:5432/yaye_academy?schema=public"

# Chapa hosted checkout (use test credentials locally)
CHAPA_SECRET_KEY="replace-with-chapa-test-secret-key"
CHAPA_WEBHOOK_SECRET="replace-with-at-least-32-random-characters"
CHAPA_MODE="test"
